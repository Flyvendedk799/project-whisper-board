# --- Required -----------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with VITE_ — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin, used for invite and email links (e.g. https://consflow.app)
SITE_URL=

# --- Optional -----------------------------------------------------------------
# Every block below is optional. The app runs fully without them; see README.

# AI (ticket drafting, triage, summaries, screenshot analysis)
AI_API_KEY=
AI_BASE_URL=https://ai.gateway.lovable.dev/v1
AI_MODEL=google/gemini-3-flash-preview

# Email. Unset -> messages are recorded in the in-app Outbox instead of sent.
RESEND_API_KEY=
EMAIL_FROM=

# Payments. Unset -> invoices are settled with "Mark as paid".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Error reporting. Unset -> errors are written to the app_errors table.
SENTRY_DSN=
