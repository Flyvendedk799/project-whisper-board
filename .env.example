# Copy to .env.local for local work. `.env` is gitignored and the deployment
# injects these names itself, so nothing here is a secret store.
#
# --- Required -----------------------------------------------------------------
# Self-hosted Supabase is served from the app's own origin: the tunnel routes
# /auth/v1, /rest/v1, /storage/v1, /realtime/v1, /functions/v1 and /graphql/v1 to
# the local stack. So the API URL is just the site URL — no separate subdomain,
# no CORS. In production these are injected; set them only for a local stack.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# The platform injects SUPABASE_ANON_KEY; either name is accepted.
SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with VITE_ — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin, used for invite and email links (e.g. https://boared.online)
SITE_URL=

# --- Optional -----------------------------------------------------------------
# Every block below is optional. The app runs fully without them; see README.

# AI (ticket drafting, triage, summaries, screenshot analysis).
# Talks straight to the provider that owns the model. The wire is derived from
# AI_MODEL, so setting a Claude id uses Anthropic and a GPT id uses OpenAI.
# The key may be given as AI_API_KEY, or per wire as ANTHROPIC_API_KEY /
# OPENAI_API_KEY. Unset -> AI affordances hide themselves.
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# Only to route the same wire through a proxy. Defaults to the provider's own host.
AI_BASE_URL=
# Only needed for a model this build's catalogue does not know: anthropic | openai
AI_WIRE=

# Email goes out over the host's own SMTP relay — the same relay and sender the
# auth service uses for password resets. The platform injects all of these.
# Unset -> messages are recorded in the in-app Outbox instead of sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# Payments. Unset -> invoices are settled with "Mark as paid".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Error reporting. Unset -> errors are written to the app_errors table.
SENTRY_DSN=
